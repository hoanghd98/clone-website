# SQLite path is relative to the prisma/ folder → project root data/dev.db
DATABASE_URL="file:../data/dev.db"
# Docker (compose overrides to this):
# DATABASE_URL="file:/app/data/dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/namphuong?schema=public"
# MySQL example:
# DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/namphuong"
#
# Optional: pin dialect for prisma/lib helpers (sequence sync, etc.).
# Must match schema.prisma datasource provider: sqlite | postgresql | mysql
# If unset, inferred from DATABASE_URL scheme.
# DATABASE_PROVIDER="sqlite"

# Optional: auto-generated by scripts/ensure-env.sh on app start if unset
JWT_SECRET=
SEED_ADMIN_PASSWORD=
