generator client {
  provider = "prisma-client-js"
}

// Switch provider when migrating: "sqlite" | "postgresql" | "mysql"
// Then update DATABASE_URL and run: npx prisma migrate dev
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("News")
}

model Gallery {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url")
  caption   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("Gallery")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ContactMessage")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String?  @map("full_name")
  email        String?
  phone        String?
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("User")
}
